# Copy this file to .env and fill in all values before starting the server.
# Never commit .env to version control.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/spims_cptech

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_96_CHAR_HEX

JWT_EXPIRE=24h
JWT_COOKIE_EXPIRE=1
CLIENT_URL=http://localhost:5173

# Default admin account — used only on first run to seed the database.
# Once the account is created, changing these values has no effect on the
# stored password; use the change-password feature in the application instead.
DEFAULT_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
